ExamPaper ||--o{ SessionExam : "dung trong ca"
ExamPaper ||--o{ SlotTpl : "dinh nghia kip"
SlotTpl ||--o{ SlotTplExam : "gan de thi"
ExamPaper ||--o{ SlotTplExam : "duoc gan vao kip"
