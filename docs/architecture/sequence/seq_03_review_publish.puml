@startuml SEQ_03_REVIEW_PUBLISH
'==============================================================
' AIVES - SEQUENCE DIAGRAM 3: REVIEW, PUBLISH & STUDENT VIEW
' Nguon: backend/Aives.Api/Controllers/ResultsController.cs
'       backend/Aives.Api/Controllers/StudentResultController.cs
'       backend/Aives.Api/Controllers/AnswerAudioController.cs
'       backend/Aives.Api/Controllers/RetryAnswerController.cs
'       backend/Aives.Api/Controllers/RetakesController.cs
'==============================================================
title SEQUENCE 3 - REVIEW, CONG BO & XEM KET QUA

skinparam shadowing false
skinparam sequence {
  ArrowColor #1F3B52
  ArrowThickness 2.5
  LifeLineBorderColor #1F3B52
  LifeLineBackgroundColor #F7FAFC
  LifeLineThickness 2
  ParticipantBackgroundColor #EAF1F7
  ParticipantBorderColor #1F3B52
  ParticipantBorderThickness 2
  ParticipantFontSize 20
  ParticipantFontStyle bold
  ParticipantPadding 14
  ActorBackgroundColor #EAF1F7
  ActorBorderColor #1F3B52
  ActorBorderThickness 2
  ActorFontSize 20
  ActorFontStyle bold
  DatabaseBackgroundColor #E8F1E9
  DatabaseBorderColor #1F3B52
  DatabaseFontSize 19
  DatabaseFontStyle bold
  GroupBackgroundColor #EAF1F7
  GroupBorderColor #1F3B52
  GroupFontSize 20
  GroupFontStyle bold
  NoteBackgroundColor #FFF3CD
  NoteBorderColor #B8860B
  NoteFontSize 18
  NoteFontStyle bold
  NoteBorderThickness 2
  BoxPadding 10
  DividerBackgroundColor #1F3B52
  DividerFontSize 18
}
skinparam titleFontSize 26
skinparam titleFontStyle bold
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 18

autonumber

actor "Khao thi\n(Examiner)" as Examiner
participant "Web SPA\n(TeacherResultsPage)" as SPA
participant "ResultsController" as Ctrl
participant "ResultService" as Svc
participant "AnswerAudioController" as AudioCtrl
participant "Cloudflare R2\n(Object Storage)" as R2
database "PostgreSQL\n(Neon)" as DB
actor "Sinh vien\n(Student)" as Student

== Giai doan 1: Khao thi xem bai lam ==

Examiner -> SPA: Mo danh sach bai cho review
SPA -> Ctrl: GET /api/results/pending
activate Ctrl
Ctrl -> Svc: GetAllPendingReviewResultsAsync()
Svc -> DB: SELECT Result WHERE Status = PENDING_REVIEW
DB --> Svc: Danh sach Result
Svc --> Ctrl: PendingResultDto[]
Ctrl --> SPA: 200 OK
deactivate Ctrl
SPA --> Examiner: Bang bai cho review

Examiner -> SPA: Chon 1 bai de xem chi tiet
SPA -> Ctrl: GET /api/results/{resultId}
activate Ctrl
Ctrl -> Svc: GetResultDetailForReviewAsync(resultId, teacherId)
activate Svc
Svc -> DB: SELECT Result + Answers + Questions\n+ Rubric + AiAnalysis
DB --> Svc: Chi tiet bai + diem AI + rubric
Svc --> Ctrl: ResultForReviewDto
deactivate Svc
Ctrl --> SPA: 200 OK
deactivate Ctrl
SPA --> Examiner: Hien thi bai lam, diem AI, nhận xét

== Giai doan 2: Nghe lai bang chung ==

Examiner -> SPA: Bam "Nghe audio"
SPA -> AudioCtrl: GET /api/answers/{answerId}/audio
activate AudioCtrl
AudioCtrl -> R2: Tao presigned URL
R2 --> AudioCtrl: url (presigned, het han)
AudioCtrl --> SPA: 200 OK (url)
deactivate AudioCtrl
SPA --> Examiner: Phat audio goc

== Giai doan 3: Cham diem chinh thuc ==

Examiner -> SPA: Nhap FinalScore + TeacherNotes, bam "Duyet"
SPA -> Ctrl: PUT /api/results/{resultId}/review
activate Ctrl
Ctrl -> Svc: ReviewResultAsync(resultId, request, teacherId)
activate Svc
Svc -> DB: UPDATE Result (FinalScore, TeacherNotes,\nStatus=REVIEWED, ReviewedAt)
note right of Svc
  BR-15: chi ghi final_score + teacher_comment,
  KHONG ghi de ai_score / ai_feedback
end note
Svc --> Ctrl: ResultForReviewDto
deactivate Svc
Ctrl --> SPA: 200 OK (Status = REVIEWED)
deactivate Ctrl
SPA --> Examiner: "Da duyet - co the cong bo"

== Giai doan 4: Cong bo diem ==

Examiner -> SPA: Bam "Cong bo ket qua"
SPA -> Ctrl: POST /api/results/{resultId}/publish
activate Ctrl
Ctrl -> Svc: PublishResultAsync(resultId, teacherId)
activate Svc
alt Chua review hoac thieu diem
  Svc --> Ctrl: InvalidOperationException
  deactivate Svc
  Ctrl --> SPA: 409 Conflict
  SPA --> Examiner: "Phai review truoc khi cong bo"
else Da review
  Svc -> DB: UPDATE Result (Status=PUBLISHED,\nFinalScore, PublishedAt = UTC)
  Svc -> DB: INSERT AuditLog (PUBLISH)
  Svc --> Ctrl: ResultForReviewDto
  deactivate Svc
  Ctrl --> SPA: 200 OK (Status = PUBLISHED)
  deactivate Ctrl
  SPA --> Examiner: "Da cong bo diem"
end

== Giai doan 5: Sinh vien xem ket qua ==

Student -> SPA: Mo trang ket qua
SPA -> Ctrl: GET /api/student/results/{sessionId}
activate Ctrl
Ctrl -> DB: SELECT Result WHERE Status = PUBLISHED
DB --> Ctrl: Diem chinh thuc + nhan xet
Ctrl --> SPA: 200 OK
deactivate Ctrl
SPA --> Student: Bang diem chinh thuc + nhan xet cua khao thi

note over Student, DB
  Sinh vien CHI thay diem khi Status = PUBLISHED.
  Neu Result van o PENDING_REVIEW / REVIEWED
  => API tra 404 (khong loi thong tin chua cong bo)
end note

== Giai doan 6: Xu ly su co (optional) ==

alt Khao thi muon cham lai 1 cau
  Examiner -> SPA: Bam "Cham lai"
  SPA -> Ctrl: POST /api/answers/{answerId}/retry
  Ctrl -> Svc: Enqueue RetryAnswerJob
  Svc -> DB: UPDATE Answer (Status=PROCESSING)
  note right of Svc
    Hangfire chay lai STT + chiem rubric
    cho Answer do, khong cham lai ca bai
  end note
else Can cap lai thi (retake)
  Examiner -> SPA: Bam "Cap lai thi"
  SPA -> Ctrl: POST /api/results/{resultId}/retake
  Ctrl -> Svc: GrantAsync(resultId, request, teacherId)
  Svc -> DB: UPDATE Result cu (Status=CANCELLED)
  Svc -> DB: Tao Session moi + Enrollment moi\n(lich giu nguyen, lich su giu lai)
  Svc -> DB: INSERT AuditLog (RETAKE)
  note right of Svc
    BR-16/17: lich su bai bi vo hieu hoa
    van duoc giu lai de doi so
  end note
end

@enduml
