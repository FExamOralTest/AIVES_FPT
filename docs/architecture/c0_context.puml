@startuml c0_context
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam roundcorner 10
left to right direction

actor "Admin\n(System & Accounts)" as AD #eff6ff
actor "Staff / Teacher\n(Courses, Questions & Slots)" as STF #eff6ff
actor "Student\n(Takes Oral Viva Exam)" as ST #eff6ff
actor "Examiner\n(Reviews & Publishes Grades)" as EX #eff6ff

rectangle "AIVES v2.0 Platform\n(AI-Based Interactive Viva Examination System)" as SYS #1e40af;text:ffffff

database "Cloudflare R2\n(Audio Object Storage)" as R2 #fffbeb
cloud "Google Gemini API\n(LLM Rubric Grading & TTS)" as GEM #fffbeb

AD --> SYS : Manage Users & Courses [HTTPS]
STF --> SYS : Upload .md, Approve Questions, Schedule Slots [HTTPS]
ST --> SYS : Speak Oral Answers & View Final Grades [HTTPS]
EX --> SYS : Audit Audio, Override Scores & Publish [HTTPS]

SYS --> R2 : Upload & Stream Audio (.webm)\n[S3 API / Presigned URL]
SYS --> GEM : Generate Questions, TTS & Grade\n[HTTPS / REST JSON]
@enduml
