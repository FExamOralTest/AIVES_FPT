      <uml:fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send071" name="send 18: View my result" covered="lifeline019" />
      <uml:fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv072" name="recv 18: View my result" covered="lifeline016" />
      <uml:message xmi:type="uml:Message" xmi:id="msg073" name="18. 18: View my result" messageSort="synchCall" sendEvent="send071" receiveEvent="recv072" />
      <uml:ownedComment xmi:type="uml:Comment" xmi:id="note074" body="The AI never grades on its own - the examiner must authorize the grading first. Internal Backend-AI protocol: POST /ai/evaluate/session with the header X-Internal-Token (= AI_SERVICE_SECRET_KEY), base URL http://ai-service:8000, timeout 300s. Hangfire queue: storage in the PostgreSQL schema hangfire; server aives-grading-* runs 1 worker on the grading queue (aives-api-* handles default / answers); retry 30s -&gt; 120s -&gt; 300s, max 3 attempts (BR-17)." />
    </uml:ownedBehavior>
  </uml:Model>
</xmi:XMI>