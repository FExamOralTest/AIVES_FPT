  <xmi:Documentation exporter="AIVES" exporterVersion="1.0" />
  <uml:Model xmi:type="uml:Model" xmi:id="model001" name="AIVES">
    <uml:packagedElement xmi:type="uml:Collaboration" xmi:id="collab002" name="VivaCollaboration">
