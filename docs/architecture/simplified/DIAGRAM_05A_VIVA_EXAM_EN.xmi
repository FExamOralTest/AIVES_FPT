      <uml:ownedComment xmi:type="uml:Comment" xmi:id="note085" body="The AI interviewer may ask a follow-up after every answer, depending on the rubric. Internal Backend-AI protocol: POST /ai/speech/transcribe-object and POST /ai/interview/follow-up with the header X-Internal-Token (= AI_SERVICE_SECRET_KEY), base URL http://ai-service:8000, timeout 300s." />
