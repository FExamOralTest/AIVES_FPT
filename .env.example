# PostgreSQL database for the backend (Neon or Supabase).
# Copy this file to .env and set the rotated database credentials locally.
# Keep .env private and never commit it.
DATABASE_CONNECTION='Host=<database-host>;Port=5432;Database=<database-name>;Username=<database-user>;Password=<database-password>;SSL Mode=Require;Trust Server Certificate=true'

# Neon Database Configuration (auto-generated by `neon link`)
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-domain>/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<ep-direct-domain>/neondb?sslmode=require"
NEON_BRANCH=production

# Backend ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
# Phai khop voi backend/Aives.Api/appsettings.Development.json (Jwt:Key)
Jwt__Key=your-super-secret-jwt-key-with-at-least-32-chars-long
ConnectionStrings__DefaultConnection="Host=<ep-pooler-domain>;Database=neondb;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;"
ConnectionStrings__MigrationConnection="Host=<ep-direct-domain>;Database=neondb;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;"

# AI Service (FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development

# AI Service providers (docker-compose truyền các biến này vào container).
# Locally (chạy uvicorn) thì ai-service/.env mới là file duy nhất được đọc.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_STT_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STT_PROVIDER=mock
TTS_PROVIDER=mock

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api

# Cloudflare R2 Object Storage (S3-Compatible)
CloudflareR2__AccountId="<your_cloudflare_account_id>"
CloudflareR2__AccessKeyId="<your_r2_access_key_id>"
CloudflareR2__SecretAccessKey="<your_r2_secret_access_key>"
CloudflareR2__BucketName="aives-media-bucket"
CloudflareR2__PublicBaseUrl=""
CloudflareR2__UseLocalStorageFallback="true"
