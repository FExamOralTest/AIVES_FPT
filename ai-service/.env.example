# ========================================
# AIVES AI Service - Environment Variables
# ========================================

# Service Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_LOG_LEVEL=info

# Secret key for internal API authentication (shared with Backend)
AI_SERVICE_SECRET_KEY=your-secret-key-here

# ========================================
# AI Provider Configuration
# Uncomment and fill in the provider you want to use
# ========================================

# --- Google Gemini ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- OpenAI ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Mock (default for development) ---
AI_PROVIDER=mock

# ========================================
# STT (Speech-to-Text) Configuration
# ========================================

# --- Gemini STT ---
# Gemini audio transcription uses the existing GEMINI_API_KEY.
# STT_PROVIDER=gemini
# GEMINI_STT_MODEL=gemini-3.1-flash-lite

# --- Google Cloud STT ---
# STT_PROVIDER=google
# GOOGLE_STT_API_KEY=your-google-stt-api-key-here

# --- Faster-Whisper (local, free) ---
# STT_PROVIDER=faster_whisper
# FASTER_WHISPER_MODEL=base
# FASTER_WHISPER_DEVICE=cpu
# FASTER_WHISPER_COMPUTE_TYPE=int8
# STT_MAX_AUDIO_BYTES=52428800

# Private R2 audio storage (same bucket as Backend)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=aives-exam-audios
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# --- OpenAI Whisper ---
# STT_PROVIDER=openai_whisper
# OPENAI_API_KEY=your-openai-api-key-here

# --- Mock ---
STT_PROVIDER=mock

# ========================================
# TTS (Text-to-Speech) Configuration
# ========================================

# --- Google TTS ---
# TTS_PROVIDER=google
# GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# --- Edge TTS (free, no key) ---
# TTS_PROVIDER=edge_tts

# --- OpenAI TTS ---
# TTS_PROVIDER=openai_tts
# OPENAI_API_KEY=your-openai-api-key-here

# --- Mock ---
TTS_PROVIDER=mock

# ========================================
# Backend Communication
# ========================================
BACKEND_URL=http://localhost:5000
