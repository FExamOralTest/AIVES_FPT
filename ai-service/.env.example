# AIVES AI Service - configuration template.
# Copy this file to .env and fill in the real values. KHONG commit .env.

# --- Service ---
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_LOG_LEVEL=info

# Internal Backend -> AI service token. Phai khop voi backend's AI:ApiKey
# (backend/Aives.Api/appsettings.Development.json).
AI_SERVICE_SECRET_KEY=aives-dev-internal-key

# --- AI Provider (AI_PROVIDER=mock | gemini | openai) ---
AI_PROVIDER=mock
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60
AI_RETRY_DELAY_SECONDS=2
QUESTION_GENERATION_TIMEOUT_SECONDS=240

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_STT_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- STT (STT_PROVIDER=mock | gemini | google | faster_whisper | openai_whisper) ---
STT_PROVIDER=mock
GOOGLE_STT_API_KEY=
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUT_TYPE=int8
STT_MAX_AUDIO_BYTES=52428800
STT_TIMEOUT_SECONDS=110

# --- TTS (TTS_PROVIDER=mock | google | edge_tts | openai_tts) ---
# edge_tts = Microsoft Edge TTS: mien phi, doc tieng Viet, KHONG can API key.
TTS_PROVIDER=mock
GOOGLE_TTS_API_KEY=

# --- Cloudflare R2 (cung bucket voi Backend: CloudflareR2:* trong .env.local) ---
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aives-media-bucket

# --- Backend ---
BACKEND_URL=http://localhost:5116
